{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-titans-course",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Plain (non-secret) settings. Secrets are added with `wrangler secret put` (see README).
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://course.demarkettitans.com",
    "GHL_LOCATION_ID": "DYG4MhubhMu6t5fWQcS3"
  }
}
